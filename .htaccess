DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
</IfModule>

# Le HTML applicatif doit etre servi par index.php, apres saisie du mot de passe.
<Files "index.html">
  Require all denied
  Deny from all
</Files>

# Les donnees locales ne doivent jamais etre servies directement.
<FilesMatch "(\.json|\.log|\.bak|\.tmp|\.ini)$">
  Require all denied
  Deny from all
</FilesMatch>

ErrorDocument 404 "Not found"
